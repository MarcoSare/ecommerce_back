package com.ecommerce.commons.controllers;

import java.util.Map;
import java.util.logging.Level;
import java.util.logging.Logger;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

import jakarta.validation.ConstraintViolationException;

@RestControllerAdvice //Indica que esta clase manejara excepciones a nivel global. Para controlladores REST
public class GlobalExceptionHandler {
	// Logger para registrar eventos importantes, como por ejemplo: 
    // errores de negocio, advertencias de seguridad, información de depuración, etc.
    /**
     * getLogger: Es util para registrar eventos importantes en la aplicacion.
     * devuelve un objeto Logger configurado para la clase actual.
     * 
     * en palabras mas mortales: es una herramienta para registrar información útil sobre el funcionamiento de la aplicación.
     * Por ejemplo: se puede utilizar para registrar errores que ocurren en la aplicación, advertencias sobre posibles problemas de seguridad,
     * o información de depuración durante el desarrollo.
     */
	private static final Logger LOGGER = Logger.getLogger(GlobalExceptionHandler.class.getName());
	
	// Maneja violaciones de restricciones de Bean Validation (ej. @NotNull, @Pattern)
    @ExceptionHandler(ConstraintViolationException.class)
    public ResponseEntity<Map<String, Object>> handleConstraintViolationException(ConstraintViolationException e) {
        // Registrar advertencia con detalle
    	// Desglose de la linea de codigo:
        /**
         * @property LOGGER: Es el objeto Logger que se utiliza para registrar mensajes de log.
         * @method log: Registra un mensaje de log con un nivel de severidad específico.
         * @param level: El nivel de severidad del mensaje de log.
         * @param msg: El mensaje de log a registrar.
         * @param e: La excepción que se está manejando.
         * @param e.getCause(): Obtiene la causa raíz de la excepción, si está disponible.
         * 
         * 
         * @condition (e.getCause() != null ? e.getCause() : e.getMessage()):
         * Esta condicion nos verifica o pregunta si la causa de la excepcion es nula. Entonces devuelve
         * la causa, si no, el mensaje de la excepcion.
         * 
         * ¿Que es la causa?:
         * La causa es la excepción original que provocó la excepción actual.
         * Puede proporcionar información adicional sobre el error.
         * 
         * @return: Un objeto ResponseEntity que representa la respuesta HTTP.
         */
    	
        LOGGER.log(Level.WARNING, "Violación de restricción: " + (e.getCause() != null ? e.getCause() : e.getMessage()));
        // Respuesta simple con código y mensaje
        /*
         * @code: El código de estado HTTP que se devolverá en la respuesta.
         * @response: El mensaje de error que se incluirá en la respuesta.
         * 
         * @ResponseEntity: El objeto que representa la respuesta HTTP completa,
         * incluyendo el código de estado y el cuerpo.
         * 
         * .badRequest(): Método estático que crea una respuesta HTTP con el código de estado 400 (Bad Request).
         * .body(): Método que establece el cuerpo de la respuesta HTTP.
         * Map.of(): Método que crea un mapa inmutable con las claves y valores proporcionados.
         */
        return ResponseEntity.badRequest().body(Map.of(
                "code", HttpStatus.BAD_REQUEST.value(),
                "response", "Violación de restricción: " + e.getMessage()
        ));
    }
}