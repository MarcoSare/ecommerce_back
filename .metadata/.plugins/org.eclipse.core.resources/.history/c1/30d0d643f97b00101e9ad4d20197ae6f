package com.ecommerce.clientes.services;

import org.springframework.stereotype.Service;

import com.ecommerce.clientes.repositories.ClienteRepository;

/**
 * Esta clase implementa ClientesService porque centraliza la lógica de negocio
 * relacionada con operaciones CRUD de clientes. Obtiene/almacena entidades
 * desde ClienteRepository, utiliza un mapper (ClienteMapper) para convertir
 * entre ClientesRequest/ClientesResponse y la entidad Cliente, y devuelve
 * los DTOs (ClientesResponse) al controlador REST para responder al cliente HTTP.
 * Además está anotada con @Service y @Transactional para gestionar el ciclo de vida y la transacción.
 *
 * IMPORTANTE: Los repositorios (p. ej. ClienteRepository) deben existir y estar creados
 * antes de instanciar este servicio, ya que la implementación los inyecta por constructor
 * y depende de ellos para obtener/persistir entidades.
 *
 * REQUISITO ADICIONAL: Este servicio requiere un mapper (ClienteMapper) que:
 *  - Convierte ClientesRequest -> Cliente (antes de persistir).
 *  - Convierte Cliente -> ClientesResponse (antes de devolver al cliente).
 *  - Debe estar implementado en este microservicio (o ser un bean inyectable) antes de usar el servicio.
 *  - Si no existe el mapper, la conversión entre DTO y entidad tendría que implementarse manualmente
 *    dentro del servicio, aumentando acoplamiento y responsabilidad.
 */

@Service
public class ClienteServiceImpl implements ClienteService {
	
	// Repositorio JPA inyectado por constructor (acceso a datos: find/save/delete...)
    private final ClienteRepository clienteRepository;

    // Mapper para convertir entidad <-> DTO. Lo instanciamos aquí (alternativa: inyectarlo si es bean).
    private final ClienteMapper mapper = new ClienteMapper();
}
